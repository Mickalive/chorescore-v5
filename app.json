{
  "expo": {
    "name": "ChoreScore",
    "slug": "chorescore-v5",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "chorescore",
    "splash": {
      "backgroundColor": "#FFF5EB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.chorescore.v5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5EB"
      },
      "package": "app.chorescore.v5",
      "intentFilters": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
