# Copy to deploy/.env on the server and fill in real values. Never commit it.
# Public Firebase project identifier (not a secret, not a service account).
# ChoreScore's confirmed public ID; override only when intentionally using another project.
FIREBASE_PROJECT_ID=chorescore-a75b1
# Hostname whose DNS A/AAAA record points at this server; Caddy obtains TLS.
COLLAB_DOMAIN=
# Absolute or relative host directories; chown them to 1000:1000.
COLLAB_DATA_DIR=./data
COLLAB_BACKUP_DIR=./backups
