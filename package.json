{
  "name": "chorescore-v5",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --platform android",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:web": "expo export --platform web --output-dir dist-web && node scripts/verify-web.cjs",
    "build:backend": "tsc -p backend/tsconfig.json",
    "test:backend": "npm run build:backend && node --test backend-tests/*.test.cjs",
    "start:backend": "node dist-backend/backend/main.js",
    "backup:collab": "node scripts/backend/backup.mjs",
    "restore:collab": "node scripts/backend/restore.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-manipulator": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/runtime": "^7.20.0",
    "@expo/metro-runtime": "~57.0.16",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~5.7.0"
  },
  "jest": {
    "preset": "jest-expo",
    "globals": {
      "__TEST__": true
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testMatch": [
      "**/__tests__/**/*.{ts,tsx,js,jsx}",
      "**/*.{test,spec}.{ts,tsx,js,jsx}"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
